{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "CounterShift": {
    "Ingestion": {
      "MaxLateness": "00:05:00",
      "MaxClockSkew": "00:00:30"
    },
    "MaxWindow": "7.00:00:00",
    "RetentionCleanupInterval": "00:05:00",
    "MaxPoolSize": 20,
    "Counters": [
      { "Name": "payment_failed_by_card", "EventType": "payment.failed", "Entity": "cardId" },
      { "Name": "payment_failed_by_user", "EventType": "payment.failed", "Entity": "userId" },
      { "Name": "login_failed_by_user", "EventType": "login.failed", "Entity": "userId" },
      { "Name": "ride_requested_by_user", "EventType": "ride.requested", "Entity": "userId" }
    ],
    "Rules": [
      {
        "Id": "R1",
        "Description": "Too many failed payments on one card",
        "AppliesTo": [ "payment" ],
        "Counter": "payment_failed_by_card",
        "Window": "00:10:00",
        "Threshold": 5,
        "Outcome": "Block"
      },
      {
        "Id": "R2",
        "Description": "Repeated failed logins",
        "AppliesTo": [ "login", "payment" ],
        "Counter": "login_failed_by_user",
        "Window": "00:15:00",
        "Threshold": 3,
        "Outcome": "Challenge"
      },
      {
        "Id": "R3",
        "Description": "Ride-request burst (exercises multi-granularity decomposition)",
        "AppliesTo": [ "ride" ],
        "Counter": "ride_requested_by_user",
        "Window": "01:30:00",
        "Threshold": 8,
        "Outcome": "Challenge"
      }
    ]
  }
}
