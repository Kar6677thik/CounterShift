<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="..\CounterShift.Domain\CounterShift.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Dapper" />
  </ItemGroup>
  <ItemGroup>
    <!-- Migrations ship inside the DLL, so the container image can't be missing one. An explicit
         LogicalName keeps resource names predictable (MSBuild mangles names that start with digits). -->
    <EmbeddedResource Include="Database\Migrations\*.sql" LogicalName="CounterShift.Api.Database.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CounterShift.Api.Tests" />
  </ItemGroup>
</Project>
