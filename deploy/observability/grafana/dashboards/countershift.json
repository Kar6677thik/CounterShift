          },
          "expr": "sum by (backend, op, role) (rate(cs_storage_operation_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{backend}} {{op}} {{role}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Storage errors/s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
