          },
          "expr": "sum by (backend, op, role) (rate(cs_storage_operation_duration_seconds_count{outcome=\"error\"}[$__rate_interval]))",
          "legendFormat": "{{backend}} {{op}} {{role}}",
          "refId": "A"
        }
