          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(cs_storage_secondary_write_failures_total[$__rate_interval])) or vector(0)",
          "legendFormat": "secondary write failures",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(cs_parity_shadow_dropped_total[$__rate_interval])) or vector(0)",
          "legendFormat": "shadow dropped",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(cs_storage_mode_reload_failures_total[$__rate_interval])) or vector(0)",
          "legendFormat": "mode reload rejected",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Decisions/s by outcome",
