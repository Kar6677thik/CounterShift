<Project>
  <!-- Applied to every project in the repo. One place for compiler strictness. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Warnings are bugs we haven't met yet; fail the build on them. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1707: underscores in test method names are the readable convention for tests. -->
    <!-- CA1515: "make public types internal" is aimed at libraries shipped to strangers; noise here. -->
    <!-- CA1848/CA1873: LoggerMessage source generators are a hot-path optimisation, adopted later if profiling says so. -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA1848;CA1873</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
